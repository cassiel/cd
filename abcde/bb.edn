{:tasks {:requires ([babashka.fs :as fs])
         :init     (do (def cdp "cdparanoia")
                       (defn do-tracks [ts]
                         (let [wav (format "%s.wav" ts)]
                           (shell (format "cdparanoia -w %s %s" ts wav))
                           (shell (format "flac %s" wav))
                           (fs/delete-on-exit wav))))

         test  (shell {:extra-env {"FOO" "fred"}} (format "%senv" "print"))
         rip   (shell {:extra-env {"EDITOR" "emacsclient"}} "abcde")
         check (shell "cdparanoia -vsQ")
         lm-1  (do-tracks "1-8")
         lm-2  (do-tracks "9-17")}}
